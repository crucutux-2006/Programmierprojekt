        //n-grams für x
        for(int i=0;i<=x.length()-n ;i++) {
            ngramsX.add(x.substring(i, i + n));
        }

        //n-grams für y
        for(int i=0;i<=y.length()-n ;i++) {
            ngramsY.add(y.substring(i, i + n));
        }

        if(ngramsX.isEmpty() && ngramsY.isEmpty()) {
            return 0.0;
        }

        if(ngramsX.isEmpty() || ngramsY.isEmpty()){
            return 1.0;
        }


        int size = ngramsX.size();
        ngramsX.retainAll(ngramsY);
        int size2 = ngramsX.size();


        //Jaccard
        res = size2 / (double) (size + ngramsY.size() - size2);
