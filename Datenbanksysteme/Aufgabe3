    public static Stream<String> fileLines(String path) throws IOException {
        String p = "home/Crucutux/Documents/1.Uni/2.Semester/Programmierpraktikum/3.Datenbanksysteme/AGDBS/NaturalGasBilling.csv";
        BufferedReader reader = Files.newBufferedReader(Path.of(p));
        return reader.lines()
                        .skip(1)
                        .sequential()
                        .onClose(() -> {
                            try{
                                reader.close();
                                System.out.println("Reader was closed");
                                }catch(IOException e) {
                                    throw new UncheckedIOException(e);
                                    }
                        });
    }

